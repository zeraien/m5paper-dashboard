# Copy to settings.env (git-ignored) and adjust.

# Identification sent as User-Agent to api.met.no (required by their terms of service).
YR_IDENTITY=github.com/your-name

# Forecast location.
WEATHER_LAT=50.8
WEATHER_LON=4.3

# Local timezone; forecast blocks are aligned to local hours.
TZ=Europe/Brussels

# Rendered image size in pixels (M5Paper portrait: 540x960).
SCREEN_WIDTH=540
SCREEN_HEIGHT=960

# Google Calendar private feed: Google Calendar > Settings > (calendar) >
# "Secret address in iCal format". Keep it private; anyone with it can read the calendar.
CALENDAR_ICS=https://calendar.google.com/calendar/ical/<calendar-id>/private-<key>/basic.ics
